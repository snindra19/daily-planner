# App
APP_SECRET_KEY=
APP_TIMEZONE=America/Bogota
DATABASE_URL=sqlite:///./planner.db

# LLM: mock | live. ANTHROPIC_API_KEY is required only when LLM_MODE=live.
LLM_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Calendar: mock | mcp
CALENDAR_MODE=mock
# Command and space-separated arguments that start the Google Calendar MCP server (stdio).
MCP_CALENDAR_COMMAND=
MCP_CALENDAR_ARGS=
# Optional env file with the server's Google credential paths.
MCP_CALENDAR_ENV_FILE=
# Name of the server's list-events tool.
MCP_LIST_EVENTS_TOOL=
